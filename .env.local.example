# Copy this file to .env.local if you want to override local STT defaults.
# If DAILY_INTAKE_STT_MODEL is a model name, the first run may download it.
# If you want fully offline startup, point it to a local model directory.
# medium 是当前默认推荐值；small 更快但准确率更低。
# DEVICE 可用值：auto / cuda / cpu
# COMPUTE_TYPE 可用值：auto / float16 / int8_float16 / int8 / float32 / int16
# NVIDIA GPU 机器建议先用 auto + auto；如果要显式锁定 GPU，可用 cuda + float16。
# 如果系统 PATH 里没有 CUDA 运行库，可把 DLL 放进 .runtime\nvidia\bin，
# 或通过 DAILY_INTAKE_STT_DLL_DIRS 指定一个或多个目录（Windows 下用分号分隔）。
DAILY_INTAKE_STT_MODEL=medium
DAILY_INTAKE_STT_LANGUAGE=zh
DAILY_INTAKE_STT_DEVICE=auto
DAILY_INTAKE_STT_COMPUTE_TYPE=auto
# DAILY_INTAKE_STT_DLL_DIRS=.runtime\nvidia\bin
DAILY_INTAKE_STT_BEAM_SIZE=8
DAILY_INTAKE_STT_BEST_OF=8
DAILY_INTAKE_STT_PATIENCE=1.2
DAILY_INTAKE_STT_TEMPERATURE=0
DAILY_INTAKE_STT_VAD_FILTER=true
DAILY_INTAKE_STT_TIMEOUT_SECONDS=45

# Daily intake ASR provider selection.
# First-round production path uses Qwen3-ASR 1.7B as primary and faster-whisper as backup.
DAILY_INTAKE_ASR_PRIMARY=qwen3-asr
DAILY_INTAKE_ASR_BACKUP=faster-whisper
DAILY_INTAKE_ASR_FAILOVER=true
DAILY_INTAKE_ASR_SHADOW_COMPARE=true

# Qwen3-ASR production provider. The model is lazy-loaded only when selected or probed.
DAILY_INTAKE_QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
DAILY_INTAKE_QWEN3_ASR_DEVICE=auto
DAILY_INTAKE_QWEN3_ASR_LANGUAGE=Chinese
DAILY_INTAKE_QWEN3_ASR_MAX_NEW_TOKENS=256
DAILY_INTAKE_QWEN3_ASR_TIMEOUT_SECONDS=90
DAILY_INTAKE_QWEN3_ASR_MAX_CONCURRENCY=1

# Comma-separated origins for LAN / reverse-proxy deployments.
# Example: BACKEND_CORS_ORIGINS=http://192.168.1.20,https://reports.example.com
# Use "*" only when you fully understand the risk.
# BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database backend.
# MySQL is the default production driver.
APP_DB_DRIVER=mysql
APP_DB_MYSQL_HOST=localhost
APP_DB_MYSQL_PORT=3306
APP_DB_MYSQL_SERVICE=MySQL92
APP_DB_MYSQL_DATABASE=inspection_report
APP_DB_MYSQL_USER=inspection_app
APP_DB_MYSQL_PASSWORD=change-this-in-local-env
APP_DB_MYSQL_CHARSET=utf8mb4

# Authentication seed settings.
# Copy to .env.local and set a private initial password before Phase 2+ auth setup.
SEED_SUPER_ADMIN_USERNAME=lina1124
SEED_SUPER_ADMIN_PASSWORD=change-this-in-local-env
SEED_SUPER_ADMIN_FORCE_CHANGE_PASSWORD=true

# Authentication session settings.
# Set AUTH_COOKIE_SECURE=true when serving the frontend/backend over HTTPS.
AUTH_ACCESS_TOKEN_MINUTES=60
AUTH_REFRESH_TOKEN_DAYS=14
AUTH_REFRESH_COOKIE_NAME=auth_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# MiMo API configuration (demo integration for application evaluation).
# Remove MIMO_ENABLED, MIMO_API_KEY, MIMO_API_BASE, MIMO_MODEL after evaluation.
MIMO_ENABLED=false
MIMO_API_KEY=
MIMO_API_BASE=https://platform.xiaomimimo.com
MIMO_MODEL=MiMo-V2.5-72B

# Qwen3-ASR lab model cache and Hugging Face download behavior.
# Keep model files off the small C: drive and disable hf_xet on Windows.
HF_HOME=.cache/huggingface
HUGGINGFACE_HUB_CACHE=.cache/huggingface/hub
HF_HUB_CACHE=.cache/huggingface/hub
HF_HUB_DISABLE_XET=1
HF_HUB_ENABLE_HF_TRANSFER=0
HF_HUB_DISABLE_SYMLINKS_WARNING=1
